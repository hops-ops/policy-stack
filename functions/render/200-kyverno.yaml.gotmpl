# code: language=yaml
#
# Helm Release: kyverno
#
# Chart:    https://kyverno.github.io/kyverno/ (chart name: kyverno)
# Upstream: https://github.com/kyverno/kyverno
#
# Default values are colima-safe:
#   - Single replica per controller (HA bumps come from spec.kyverno.values).
#   - admissionController.failurePolicy: Ignore — Kyverno's own apiserver-wedge
#     incident (zwindler, Feb 2026) motivates the Ignore default; security
#     policies that need Fail get a separate webhook config in a later stack
#     iteration (see tasks/policy-stack-failurepolicy-split in GitKB).
#

{{- $ky := $state.kyverno }}
{{- if $ky.enabled }}
{{- $chartDefaults := dict
  "admissionController" (dict
    "replicas" 1
    "failurePolicy" "Ignore"
    "container" (dict "resources" (dict
      "requests" (dict "cpu" "296m" "memory" "105Mi")
      "limits" (dict "cpu" "1000m" "memory" "512Mi")
    ))
  )
  "backgroundController" (dict
    "replicas" 1
    "resources" (dict
      "requests" (dict "cpu" "15m" "memory" "100Mi")
      "limits" (dict "cpu" "100m" "memory" "256Mi")
    )
  )
  "reportsController" (dict
    "replicas" 1
    "resources" (dict
      "requests" (dict "cpu" "15m" "memory" "100Mi")
      "limits" (dict "cpu" "100m" "memory" "256Mi")
    )
  )
  "cleanupController" (dict
    "replicas" 1
    "resources" (dict
      "requests" (dict "cpu" "15m" "memory" "100Mi")
      "limits" (dict "cpu" "100m" "memory" "256Mi")
    )
  )
}}
{{- $mergedValues := mergeOverwrite $chartDefaults ($ky.values | default dict) }}
---
apiVersion: helm.m.crossplane.io/v1beta1
kind: Release
metadata:
  name: {{ $ky.releaseName }}
  annotations:
    {{ setResourceNameAnnotation "kyverno" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    chart:
      name: kyverno
      repository: https://kyverno.github.io/kyverno/
      version: {{ $ky.chartVersion | quote }}
    namespace: {{ $ky.namespace }}
    wait: true
    {{- if gt (len $ky.overrideAllValues) 0 }}
    values:
      {{- toYaml $ky.overrideAllValues | nindent 6 }}
    {{- else }}
    values:
      {{- toYaml $mergedValues | nindent 6 }}
    {{- end }}
  rollbackLimit: 3
  providerConfigRef:
    name: {{ $state.helmProviderConfigRef.name }}
    kind: {{ $state.helmProviderConfigRef.kind }}
{{- end }}
